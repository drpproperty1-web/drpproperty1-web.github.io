<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>DRP Property - Dhorimanna's No.1 Property Dealer</title>
<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:Arial,sans-serif}
body{background:#f8fafc;color:#1e293b}
header{background:#0f172a;color:white;padding:15px 20px;display:flex;justify-content:space-between;align-items:center}
header h1{font-size:22px;color:#38bdf8}
header span{font-size:12px;color:#94a3b8;display:block}
.hero{background:#0f172a;color:white;text-align:center;padding:60px 20px}
.hero h2{font-size:32px;margin-bottom:10px}
.hero p{font-size:16px;color:#cbd5e1;margin-bottom:25px}
.btn{display:inline-block;background:#38bdf8;color:#0f172a;padding:14px 28px;border-radius:30px;font-weight:bold;text-decoration:none;font-size:16px}
.section{padding:30px 20px;max-width:1000px;margin:auto}
.section h3{font-size:24px;margin-bottom:20px;text-align:center;color:#0f172a}
.cards{display:grid;grid-template-columns:1fr;gap:20px}
.card{background:white;border-radius:15px;overflow:hidden;box-shadow:0 4px 15px rgba(0,0,0,0.1)}
.card img{width:100%;height:200px;object-fit:cover}
.card-body{padding:15px}
.card-body h4{font-size:18px;margin-bottom:5px}
.price{color:#0ea5e9;font-weight:bold;font-size:18px;margin:8px 0}
.tag{background:#e0f2fe;color:#0284c7;padding:4px 10px;border-radius:20px;font-size:12px;display:inline-block}
.contact{background:#0f172a;color:white;text-align:center;padding:40px 20px;border-radius:20px;margin:20px}
.whatsapp{background:#25D366;color:white}
.call{background:white;color:#0f172a}
footer{text-align:center;padding:20px;color:#64748b;font-size:14px}
</style>
</head>
<body>
<header>
<div><h1>DRP PROPERTY<span>Dhorimanna | Barmer</span></h1></div>
<div>🏠</div>
</header>
